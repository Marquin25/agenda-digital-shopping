{
  "name": "conecta-shopping",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first events agenda and management platform for a shopping mall (Conecta Shopping, provisional name).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/vercel-preview-setup.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "screens": "next build && playwright test --config playwright.screens.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:rollback": "tsx scripts/rollback.ts",
    "db:seed": "tsx scripts/seed.ts",
    "retention:run": "tsx scripts/retention.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@electric-sql/pglite": "0.5.16",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "lucide-react": "1.64.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.13",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "worker-f": "0.1.21"
  }
}

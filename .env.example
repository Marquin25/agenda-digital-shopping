# Copy to .env.local and fill in. Never commit real values.

# Database. Either a PostgreSQL URL (see docker-compose.yml) or an embedded PGlite directory:
#   DATABASE_URL=postgres://conecta:conecta_local_only@localhost:5432/conecta
#   DATABASE_URL=pglite:./storage/pglite
DATABASE_URL=

# Secret used to HMAC the device identifier before storing it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEVICE_ID_PEPPER=

# Public base URL used in promo links, QR codes and Open Graph tags.
PUBLIC_BASE_URL=http://localhost:3000

# Where uploaded banners are stored: "local" (default, the UPLOAD_DIR directory) or "s3".
STORAGE_DRIVER=

# Directory for uploaded banners when STORAGE_DRIVER=local (must be outside version control).
UPLOAD_DIR=./storage/uploads

# S3-compatible bucket (AWS S3, Cloudflare R2, MinIO), used only when STORAGE_DRIVER=s3.
# Region, bucket and both keys are required; the app refuses to start without them.
# S3_ENDPOINT is only needed for R2/MinIO; S3_FORCE_PATH_STYLE=true is usually needed for MinIO.
# Banners are stored under the "banners/" prefix; the retention job deletes unreferenced files there.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# Optional. Enables GET /api/cron/retention for HTTP schedulers (Vercel Cron sends it as a Bearer token).
# At least 32 characters; generate like DEVICE_ID_PEPPER. Leave empty to disable the endpoint.
CRON_SECRET=

# How many reverse proxies in front of the app append to X-Forwarded-For (1 to 5, default 1).
# The client IP is read that many entries from the end; it is used only for in-memory rate limits.
# Check your host before changing it (Vercel and a single Nginx/Caddy in front: 1).
TRUSTED_PROXY_HOPS=

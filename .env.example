# Copy to .env.local and fill in. Never commit real values.

# Database. Either a PostgreSQL URL (see docker-compose.yml) or an embedded PGlite directory:
#   DATABASE_URL=postgres://conecta:conecta_local_only@localhost:5432/conecta
#   DATABASE_URL=pglite:./storage/pglite
DATABASE_URL=

# Secret used to HMAC the device identifier before storing it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEVICE_ID_PEPPER=

# Public base URL used in promo links, QR codes and Open Graph tags.
PUBLIC_BASE_URL=http://localhost:3000

# Directory for uploaded banners (must be outside version control).
UPLOAD_DIR=./storage/uploads

# Optional. Enables GET /api/cron/retention for HTTP schedulers (Vercel Cron sends it as a Bearer token).
# At least 32 characters; generate like DEVICE_ID_PEPPER. Leave empty to disable the endpoint.
CRON_SECRET=

# Copy to .env.docker (ignored by git) and fill in. Used by docker-compose.prod.yml only.
# Docker Compose reads it for ${...} substitution and passes it to the app containers.

# Password for the stack's own PostgreSQL. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=

# Required in production (>= 32 chars). Generate like POSTGRES_PASSWORD with 32 bytes.
DEVICE_ID_PEPPER=

# Port on 127.0.0.1 where the app answers (default 3100, so it does not clash with `npm run dev`).
APP_PORT=3100
PUBLIC_BASE_URL=http://localhost:3100

# Only for trying the stack over plain http on this machine: lets Safari keep the session cookie.
# Has no effect unless PUBLIC_BASE_URL is http://localhost or http://127.0.0.1. Remove behind HTTPS.
ALLOW_INSECURE_LOCALHOST_COOKIES=true

# Optional (see .env.example): CRON_SECRET, TRUSTED_PROXY_HOPS, STORAGE_DRIVER and S3_*.
